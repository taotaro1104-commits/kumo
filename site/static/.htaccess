# Lite Simple Rust Browser 紹介サイト用 .htaccess（Hugo の public/ をそのまま置く前提）
# 各ブロックは <IfModule> で囲んであり、モジュールが無いサーバーでも 500 にならない。

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html

# ---- HTTPS と正規ホスト ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https（プロキシ／CDN 配下でも判定できるよう X-Forwarded-Proto も見る）
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # トップ（/）は、ブラウザの優先言語に合わせて各言語のページへ（該当しなければ、言語指定があれば英語、なければ日本語）
  RewriteCond %{HTTP:Accept-Language} ^ja [NC]
  RewriteRule ^$ /ja/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^zh [NC]
  RewriteRule ^$ /zh/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^ko [NC]
  RewriteRule ^$ /ko/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^es [NC]
  RewriteRule ^$ /es/ [L,R=302]
  RewriteCond %{HTTP:Accept-Language} ^[a-z]
  RewriteRule ^$ /en/ [L,R=302]
  RewriteRule ^$ /ja/ [L,R=302]

  # ---- 許可リスト方式：公開するファイルだけを通し、それ以外は 404 ----
  # 1) 読み取り専用のサイトなので、GET・HEAD・OPTIONS 以外は受け付けない
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteRule ^ - [F,L]

  # 2) 親ディレクトリへの遡り（..）、空のパス区間（//）、制御文字を含む要求は 404
  RewriteCond %{REQUEST_URI} (\.\./|/\.\.$|//|%2e%2e|%00|%0d|%0a) [NC]
  RewriteRule ^ - [R=404,L]

  # 3) 言語ページの正規の URL は /ja/ のような形（/ja/index.html は 301 で寄せる）
  RewriteCond %{THE_REQUEST} \s/(ja|en|zh|ko|es)/index\.html[\s?]
  RewriteRule ^ /%1/ [L,R=301]

  # 4) 許可するパス（上から順に、どれにも当てはまらなければ 404）
  #    - /                              トップ（上で言語ページへ転送済み）
  #    - /ja/ /en/ /zh/ /ko/ /es/       言語ページのディレクトリと、その中の index.html・404.html・sitemap.xml だけ
  #    - /style.min.<ハッシュ>.css       ハッシュ付きの CSS
  #    - アイコン・OGP 画像・スクリプト・ads.txt・sitemap.xml・robots.txt
  #    - /.well-known/                  証明書の更新などの標準の置き場
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/(ja|en|zh|ko|es)/?$
  RewriteCond %{REQUEST_URI} !^/(ja|en|zh|ko|es)/((index|404)\.html|sitemap\.xml)$
  RewriteCond %{REQUEST_URI} !^/style\.min\.[0-9a-f]{64}\.css$
  RewriteCond %{REQUEST_URI} !^/(icon\.svg|icon-192\.png|favicon\.ico|favicon-32\.png|apple-touch-icon\.png|og\.png)$
  RewriteCond %{REQUEST_URI} !^/(analytics\.js|ads\.js|ads\.txt|sitemap\.xml|robots\.txt)$
  RewriteCond %{REQUEST_URI} !^/\.well-known/[A-Za-z0-9._/-]+$
  RewriteRule ^ - [R=404,L]
</IfModule>

# ---- ファイルの種類 ----
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType application/xml .xml
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- 圧縮 ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- キャッシュ ----
# CSS は Hugo がファイル名にハッシュを付けるので長期＋immutable、HTML は毎回再検証。
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # 言語で内容が変わるのは / だけ。キャッシュが取り違えないようにする
  <If "%{REQUEST_URI} == '/'">
    Header append Vary Accept-Language
    Header set Cache-Control "no-store"
  </If>

  # ---- セキュリティヘッダー ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # 自分のファイルと、Google アナリティクス（gtag）・AdSense・Google Fonts の通信先だけを許可する。
  # AdSense は広告のためにインラインのスクリプト・スタイルと第三者のフレームを使うので、その分は緩める。
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.g.doubleclick.net https://www.googletagservices.com https://partner.googleadservices.com https://adservice.google.com https://*.adtrafficquality.google; frame-src https://*.googlesyndication.com https://*.g.doubleclick.net https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.googlesyndication.com https://*.g.doubleclick.net https://*.adtrafficquality.google https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# ---- ファイルの種類の許可リスト（二重の防御） ----
# 上の RewriteRule が使えないサーバーでも効く。公開物の拡張子以外のファイル（設定・バックアップ・ソース・隠しファイル）は返さない。
# Apache は後に書いた条件が優先されるので、「全部拒否 → 公開物の拡張子だけ許可 → 隠しファイルを拒否 → .well-known だけ許可」の順に並べる。
<IfModule mod_authz_core.c>
  <FilesMatch "^.*$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(html|css|js|svg|png|ico|txt|xml)$">
    Require all granted
  </FilesMatch>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/\.well-known/[A-Za-z0-9._/-]+$#">
    Require all granted
  </If>
</IfModule>

# ---- エラーページ ----
ErrorDocument 404 /ja/404.html
