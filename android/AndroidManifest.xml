<?xml version="1.0" encoding="utf-8"?>
<!-- Kumo (Lite Simple Rust Browser) for Android: NativeActivity が libkumo.so の android_main を呼ぶ。Java のコードは無い -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kumo.browser"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Kumo"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Kumo"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="kumo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
